{
  "name": "bug-intake-dashboard-study",
  "version": "2.1.0",
  "description": "Controlled bug intake dashboard for software engineering and HCI study tasks",
  "main": "src/server/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "vite build",
    "start": "node src/server/index.js",
    "server": "nodemon src/server/index.js",
    "server:debug": "nodemon --inspect src/server/index.js",
    "client": "vite",
    "dev": "npm run db:init && concurrently \"npm run server\" \"npm run client\"",
    "clean": "rm -rf dist node_modules/.cache",
    "preview": "vite preview",
    "db:init": "node src/server/db/init.js",
    "db:seed": "node src/server/db/seed.js",
    "db:reset": "node src/server/db/seed.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.4.1",
    "celebrate": "^15.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "formik": "^2.4.9",
    "helmet": "^8.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.12.0",
    "react-toastify": "^11.0.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
